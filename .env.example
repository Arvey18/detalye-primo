# Copy this file to `.env` and adjust the values.
#
# ⚠️ Every VITE_* variable is embedded in the public JavaScript bundle.
#    Never put secrets (API secret keys, passwords) here.
#
# Vite loads, in order of priority:
#   .env.[mode].local > .env.[mode] > .env.local > .env
# (mode is "development" for `npm run dev`, "production" for `npm run build`)

# Production origin — used for canonical URLs, social previews and the sitemap.
VITE_SITE_URL=https://detalyeprimo.com
